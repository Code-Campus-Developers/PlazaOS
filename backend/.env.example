MONGODB_URI=mongodb://localhost:27017/plaza-os
JWT_SECRET=replace-with-a-long-random-secret
# Access-token lifetime. The code falls back to 14d when unset, which is the
# value decided in BACKEND_BUILD_PLAN.md §13.
JWT_EXPIRES_IN=14d
FRONTEND_URL=http://localhost:5173
# Comma-separated allow-list of browser origins permitted to call the API — never
# a wildcard. Defaults to the local Vite dev origin; in production add the
# deployed frontend's origin too (e.g. https://app.plazaos.ng).
CORS_ORIGIN=http://localhost:5173
PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYSTACK_PUBLIC_KEY=pk_test_replace_me
PAYSTACK_CURRENCY=NGN
CRON_SECRET=replace-with-a-long-random-string
CLOUDINARY_CLOUD_NAME=replace-me
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me

# Email provider for transactional email (payment confirmation/failure and rent
# reminders are wired up per BACKEND_BUILD_PLAN.md §9; maintenance-status-change
# and important-announcement emails are deferred until their §3.2 admin CRUD
# routes exist). Leave unset (or "replace-me") in dev — src/lib/email.ts skips
# sending rather than throwing when no real Resend key is configured.
# onboarding@resend.dev is Resend's built-in sandbox sender — works with no
# domain verification, but only delivers to the email address on this Resend
# account. Swap to a verified-domain address before sending to real tenants.
RESEND_API_KEY=re_replace_me
RESEND_FROM_EMAIL=onboarding@resend.dev

# Real admin bootstrap (scripts/bootstrap-admin.ts) — required, no default, never committed.
ADMIN_EMAIL=admin@plaza.test
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME=Admin

# Dev-only mock-data seed script (scripts/seed.ts, refuses to run when NODE_ENV=production).
# Leave unset to have the script generate and print a random tenant password instead.
SEED_TENANT_PASSWORD=
